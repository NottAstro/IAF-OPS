# =====================================================================
#  iaf-airops: local environment (DO NOT COMMIT; already in .gitignore)
#  Everything runs without keys; the keys below unlock extra features.
#  Copy this file to .env, fill the values marked  >>> PASTE HERE <<<, then run: make setup db seed dev
# =====================================================================

# ---------------------------------------------------------------------
# 1) CESIUM ION TOKEN: NO LONGER USED. The map moved from CesiumJS to
#    MapLibre (ARCHITECTURE D19); terrain now comes from keyless AWS
#    Terrain Tiles. You can leave this empty or delete it.
# ---------------------------------------------------------------------
VITE_CESIUM_ION_TOKEN=

# ---------------------------------------------------------------------
# 2) OPENWEATHERMAP API KEY: weather map overlays (clouds, rain, wind,
#    temperature, pressure). FREE plan is enough.
#    a) Sign up:   https://home.openweathermap.org/users/sign_up
#    b) Copy key:  https://home.openweathermap.org/api_keys
#    Note: a new key can take up to ~2 hours to activate.
# ---------------------------------------------------------------------
OWM_API_KEY=                      # >>> PASTE HERE <<<

# ---------------------------------------------------------------------
# 3) OPENSKY NETWORK API CLIENT: optional, 10x more live-flight credits
#    (anonymous works but only allows a snapshot every ~15 minutes).
#    a) Register:  https://opensky-network.org/index.php?option=com_users&view=registration
#    b) Log in -> https://opensky-network.org/my-opensky/account
#       -> "API Client" -> create -> copy client_id and client_secret
#    Docs: https://openskynetwork.github.io/opensky-api/rest.html
# ---------------------------------------------------------------------
OPENSKY_CLIENT_ID=                # >>> PASTE HERE (optional) <<<
OPENSKY_CLIENT_SECRET=            # >>> PASTE HERE (optional) <<<

# ---------------------------------------------------------------------
# 4) AIRPLANES.LIVE: optional 3rd flight feed. No key; access is
#    granted by email. Write to contact@airplanes.live with the project
#    description (https://airplanes.live/api-guide). If they approve,
#    add ",airplanes.live" to ADSB_PROVIDERS below.
# ---------------------------------------------------------------------
ADSB_PROVIDERS=adsb.lol,adsb.fi,opensky
ADSB_MAX_CIRCLES=4

# ---------------------------------------------------------------------
# No keys needed for: adsb.lol, adsb.fi, adsbdb, aviationweather.gov,
# Open-Meteo, NOAA GFS/ECMWF wind, NOAA nowCOAST, Esri imagery, and all
# boundary / OSM / airport downloads.
# ---------------------------------------------------------------------

# ----- App settings (pre-filled; no action needed) -------------------
DATABASE_URL=postgresql+psycopg://airops:airops@127.0.0.1:5432/airops   # 127.0.0.1, not localhost: on Windows localhost tries IPv6 first (+5 s per connection)
JWT_SECRET=change-me-generate-with-python-secrets
JWT_TTL_HOURS=8
DEMO_PASSWORD=Vayu@2026           # password for all seeded demo users (admin, airhq, viewer, cdr.viax ...)
SEED=2026
SIM_ENABLED=true
SIM_TICK_SECONDS=5
SIM_SPEED=10
SIM_ASSERT=0
AWC_USER_AGENT=iaf-airops/0.1 (SIH26250 student prototype)
WIND_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173
HTTPS_CA_BUNDLE=                  # only if a TLS-inspecting firewall breaks HTTPS (path to its CA .pem)
OFFLINE_MODE=false
LOG_LEVEL=info

# Backend port
API_PORT=8010
